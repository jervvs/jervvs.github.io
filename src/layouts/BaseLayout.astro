---
import ClientRouter from 'astro/components/ClientRouter.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AmbientCanvas from '../components/AmbientCanvas.astro';
import { SITE } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = SITE.tagline,
  currentPath = Astro.url.pathname,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
---

<html lang="en">
<head>
  <!-- Theme: respect system preference, manual toggle overrides -->
  <script is:inline>
    (function() {
      var saved = localStorage.getItem('theme');
      var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : '');
      if (theme) document.documentElement.setAttribute('data-theme', theme);
    })();
    document.addEventListener('astro:after-swap', function() {
      var saved = localStorage.getItem('theme');
      var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : '');
      if (theme) document.documentElement.setAttribute('data-theme', theme);
    });
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:site_name" content={SITE.name} />
  <link rel="canonical" href={Astro.url} />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <title>{pageTitle}</title>
  <ClientRouter />
</head>
<body>
  <AmbientCanvas />
  <Nav currentPath={currentPath} />
  <main class="page-content">
    <slot />
    <Footer />
  </main>
  <script>
    // @ts-nocheck
    import { animate } from 'motion';

    function getThemeParams() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      return { duration: isDark ? 0.4 : 0.6, stiffness: isDark ? 120 : 80, damping: isDark ? 12 : 20 };
    }

    document.addEventListener('astro:page-switch', () => {
      // Outgoing page: fade up and out
      const content = document.querySelector('.page-content');
      if (content) {
        animate(content, { opacity: [1, 0], y: [0, -20] }, { duration: 0.2 });
      }
    });

    document.addEventListener('astro:after-swap', () => {
      const { duration, stiffness, damping } = getThemeParams();
      const content = document.querySelector('.page-content');
      if (content) {
        // Incoming page: wave stagger from below
        animate(content, { opacity: [0, 1], y: [30, 0] }, {
          duration,
          easing: [stiffness / 200, damping / 30, 0.2, 1],
        });
      }
    });
  </script>
</body>
</html>
