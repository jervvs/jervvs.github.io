---
<button class="theme-toggle" data-theme-toggle aria-label="Toggle theme">
  <span class="toggle-dot"></span>
</button>

<style>
  .theme-toggle {
    width: 38px;
    height: 20px;
    background: var(--toggle-bg);
    border-radius: 10px;
    border: none;
    cursor: pointer;
    position: relative;
    transition: background 0.4s;
    flex-shrink: 0;
  }

  .toggle-dot {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--toggle-dot);
    transition: background 0.4s;
  }

  :global([data-theme="dark"]) .toggle-dot {
    transform: translateX(18px);
  }
</style>

<script>
  import { animate } from 'motion';

  function initThemeToggle() {
    document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? '' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);

        const dot = btn.querySelector('.toggle-dot');
        if (dot) {
          const targetX = next === 'dark' ? 18 : 0;
          animate(dot, { x: targetX }, { type: 'spring', stiffness: 400, damping: 15 });
        }
      });
    });
  }

  // Run on initial load and after every View Transition navigation
  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
